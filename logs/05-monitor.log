# monitor.sh 배치(agent-dev:agent-core 750)와 실행 결과
# 실행 시각: 2026-09-15 13:37:35 KST  호스트: agent-server  커널: 5.15.167.4-microsoft-standard-WSL2

## 배치: 작성자 agent-dev 가 설치

agent-dev$ for f in monitor.sh report.sh log-retention.sh; do install -m 750 -g agent-core /tmp/$f $AGENT_HOME/bin/$f; done

$ stat -c '%U:%G %a %n' /home/agent-admin/agent-app/bin/*.sh
agent-dev:agent-core 750 /home/agent-admin/agent-app/bin/log-retention.sh
agent-dev:agent-core 750 /home/agent-admin/agent-app/bin/monitor.sh
agent-dev:agent-core 750 /home/agent-admin/agent-app/bin/report.sh

## sudoers: agent-admin 에게 방화벽 상태 조회 한 가지만 허용

$ cat /etc/sudoers.d/agent-monitor && visudo -cf /etc/sudoers.d/agent-monitor
agent-admin ALL=(root) NOPASSWD: /usr/sbin/ufw status
/etc/sudoers.d/agent-monitor: parsed OK

agent-admin$ sudo -n -l
Matching Defaults entries for agent-admin on agent-server:
    env_reset, mail_badpass, secure_path=/usr/local/sbin\:/usr/local/bin\:/usr/sbin\:/usr/bin\:/sbin\:/bin\:/snap/bin, use_pty

User agent-admin may run the following commands on agent-server:
    (root) NOPASSWD: /usr/sbin/ufw status

