# 계정/그룹 생성, 디렉터리 권한(ACL), SSH 접속 검증
# 실행 시각: 2026-09-15 13:37:30 KST  호스트: agent-server  커널: 5.15.167.4-microsoft-standard-WSL2

## 그룹

$ groupadd -f agent-common && groupadd -f agent-core

## 계정 (다시 실행하면 그룹 소속만 맞춘다)

$ useradd -m -s /bin/bash -G agent-common,agent-core agent-admin

$ useradd -m -s /bin/bash -G agent-common,agent-core agent-dev

$ useradd -m -s /bin/bash -G agent-common agent-test

$ id agent-admin; id agent-dev; id agent-test
uid=1000(agent-admin) gid=1002(agent-admin) groups=1002(agent-admin),1000(agent-common),1001(agent-core)
uid=1001(agent-dev) gid=1003(agent-dev) groups=1003(agent-dev),1000(agent-common),1001(agent-core)
uid=1002(agent-test) gid=1004(agent-test) groups=1004(agent-test),1000(agent-common)

$ getent group agent-common agent-core
agent-common:x:1000:agent-admin,agent-dev,agent-test
agent-core:x:1001:agent-admin,agent-dev

## 디렉터리 생성

$ mkdir -p /home/agent-admin/agent-app/upload_files /home/agent-admin/agent-app/api_keys /home/agent-admin/agent-app/bin /var/log/agent-app /var/log/monitor/agent-app/archive

## 권한 부여
# Ubuntu 22.04 는 홈을 750 으로 만든다. 다른 계정이 AGENT_HOME 에 닿도록 목록 조회 없이 통과(x)만 허용한다.

$ setfacl -m g:agent-common:--x /home/agent-admin

$ chown agent-admin:agent-common /home/agent-admin/agent-app && chmod 750 /home/agent-admin/agent-app
# upload_files: agent-common(admin, dev, test) 읽기/쓰기. setgid 와 기본 ACL 로 새 파일도 같은 그룹 권한을 물려받는다.

$ chown agent-admin:agent-common /home/agent-admin/agent-app/upload_files && chmod 2770 /home/agent-admin/agent-app/upload_files

$ setfacl -m g:agent-common:rwx -d -m g:agent-common:rwx /home/agent-admin/agent-app/upload_files
# api_keys, /var/log/agent-app: agent-core(admin, dev)만 읽기/쓰기. others 는 권한 없음.

$ chown agent-admin:agent-core /home/agent-admin/agent-app/api_keys && chmod 2770 /home/agent-admin/agent-app/api_keys

$ setfacl -m g:agent-core:rwx -d -m g:agent-core:rwx /home/agent-admin/agent-app/api_keys

$ chown agent-admin:agent-core /var/log/agent-app && chmod 2770 /var/log/agent-app

$ setfacl -m g:agent-core:rwx -d -m g:agent-core:rwx /var/log/agent-app
# bin: monitor.sh 작성자 agent-dev 소유, agent-core 는 읽기·실행만.

$ chown agent-dev:agent-core /home/agent-admin/agent-app/bin && chmod 2750 /home/agent-admin/agent-app/bin

$ chown -R agent-admin:agent-core /var/log/monitor && chmod -R 2770 /var/log/monitor

